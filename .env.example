# Gemini API 키 (https://aistudio.google.com/apikey 에서 발급). 이 파일을 .env 로 복사해 채우세요.
# .env 는 절대 커밋하지 마세요(.gitignore 처리됨).
GEMINI_API_KEY=
# 사용할 모델. 모델명은 자주 바뀌므로 공식 문서(ai.google.dev)에서 확인 후 바꾸세요.
GEMINI_MODEL=gemini-2.5-flash
# 분당 호출 상한(무료 티어 한도에 맞춰 조정). 초과 시 자동 대기.
GEMINI_RPM=10
# 하루 호출 상한(0=제한 없음). 무료 티어 일일 한도에 맞추면 한도 도달 전에 깔끔히 멈추고, 다음 날 같은 명령으로 이어집니다.
GEMINI_RPD=0
# (tesseract 모드) 실행 파일이 PATH 에 없을 때만 전체 경로 지정. 예: C:\\Program Files\\Tesseract-OCR\\tesseract.exe
# TESSERACT_CMD=
